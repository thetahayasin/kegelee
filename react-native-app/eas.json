{
  "cli": {
    "version": ">= 21.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production-ios": {
      "extends": "production",
      "ios": {
        "image": "sdk-57",
        "scheme": "Kegelee",
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "local",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production-ios": {
      "ios": {
        "ascAppId": "6809782947",
        "appleTeamId": "68P36W8488",
        "bundleIdentifier": "com.kegelee.app"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
