{
  "name": "com.kegelee.app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "node scripts/patch-jcenter.js",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-debug.ps1",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "build:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Aab",
    "build:test": "node scripts/patch-jcenter.js && cd android && gradlew.bat -g E:\\.gradle_home assembleDebug",
    "build:prod": "node scripts/patch-jcenter.js && node scripts/bump-version.js && cd android && gradlew.bat -g E:\\.gradle_home assembleRelease"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/stack": "^7.10.11",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keep-awake": "^4.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.5",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
