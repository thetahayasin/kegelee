<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Watches only. `required="true"` is what tells Play this artifact belongs
      to the Wear OS form factor of the listing rather than the phone one, so
      it is never offered to a phone.
    -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reminders buzz on the wrist, which is the whole reason to have them
         here rather than only on the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms do not survive a reboot; see BootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
          Standalone.

          This app signs in on its own and talks to the same API the phone
          does, so a watch with a data connection is a complete product with no
          handset in the room. Play uses this flag to let somebody install it
          from the watch without being told to find their phone first.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Google Sign-In needs Play services at the version the library was
             built against. -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/KegeleeSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Delivers a reminder and arms the following one; see Reminders.kt.
             Not exported: nothing outside this app has business firing it. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Rebuilds the reminder week after a restart, which otherwise wipes
             every armed alarm. Exported because the system is the sender. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
