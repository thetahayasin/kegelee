<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Watches only. `required="true"` is what tells Play this artifact belongs
      to the Wear OS form factor of the listing rather than the phone one, so
      it is never offered to a phone.
    -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
          Standalone.

          This app signs in on its own and talks to the same API the phone
          does, so a watch with a data connection is a complete product with no
          handset in the room. Play uses this flag to let somebody install it
          from the watch without being told to find their phone first.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Google Sign-In needs Play services at the version the library was
             built against. -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/KegeleeSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
