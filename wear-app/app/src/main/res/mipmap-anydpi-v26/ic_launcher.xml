<?xml version="1.0" encoding="utf-8"?>
<!--
  The phone app's launcher icon, copied verbatim from
  react-native-app/android/app/src/main/res - same background drawable, same
  foreground bitmap at every density. A watch app that shares a Play listing
  with a phone app should not have its own idea of what the product looks like.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
