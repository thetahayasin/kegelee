APP_NAME=Kegelee
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kegelee.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kegelee
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@kegelee.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial admin account, used by ProductionSeeder (scripts/deploy-web.ps1 -Seed)
# only when no admin exists yet. Leave ADMIN_PASSWORD blank to have a strong
# random password generated and printed once. Change it from the panel after.
ADMIN_EMAIL=admin@kegelee.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

NATIVEPHP_APP_ID=com.kegelee.app
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_START_URL=/welcome

# Server-only secret guarding the /deploy web endpoint. Generate a long random
# string; it lives ONLY in the backend .env and never ships in device builds.
# The sync API itself uses per-user tokens issued at sign-in - no shared key.
DEPLOY_KEY=

# Backend the DEVICE syncs from. Only the native app uses it, so the backend
# sharing this .env never syncs against itself.
CONTENT_SYNC_URL=https://kegelee.com/api/v1/content

NATIVEPHP_DEEPLINK_SCHEME=kegelee
NATIVEPHP_DEEPLINK_HOST=kegelee.com

# Android SDK / release signing (device builds only). Keep keystore secrets
# out of version control.
# NATIVEPHP_ANDROID_SDK_LOCATION=
# NATIVEPHP_GRADLE_PATH=
# ANDROID_KEYSTORE_FILE=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=

# Testing only: unlock every exercise regardless of completed days.
# Never ship a release build with this on.
# UNLOCK_ALL_EXERCISES=true

# Mobile splash screen (s2br/nativephp-mobile-splashscreen)
MOBILE_SPLASHSCREEN_ENABLED=true
MOBILE_SPLASHSCREEN_CONTENT=text
MOBILE_SPLASHSCREEN_TEXT=""
MOBILE_SPLASHSCREEN_ANIMATION_PATH="resources/animations/animation4.lottie"
MOBILE_SPLASHSCREEN_LOOP=false
MOBILE_SPLASHSCREEN_SIZE=0.4
MOBILE_SPLASHSCREEN_POSITION=center
MOBILE_SPLASHSCREEN_SHOW_ICON=true
MOBILE_SPLASHSCREEN_ICON_SIZE=0.45
MOBILE_SPLASHSCREEN_ICON_POSITION=top
MOBILE_SPLASHSCREEN_ICON_RADIUS=0.33
MOBILE_SPLASHSCREEN_BG_TYPE=color
MOBILE_SPLASHSCREEN_BG_COLOR="#0C0D11"
MOBILE_SPLASHSCREEN_THEME=dark
MOBILE_SPLASHSCREEN_DARK_BG_TYPE=color
MOBILE_SPLASHSCREEN_DARK_BG_COLOR="#0C0D11"
MOBILE_SPLASHSCREEN_LAUNCH_COLOR="#0C0D11"
MOBILE_SPLASHSCREEN_FADE_IN=400
MOBILE_SPLASHSCREEN_TRANSITION_OUT=fade
MOBILE_SPLASHSCREEN_TRANSITION_DURATION=400
MOBILE_SPLASHSCREEN_PROGRESS_BAR=true
MOBILE_SPLASHSCREEN_PROGRESS_BAR_COLOR="#c1ff72"
MOBILE_SPLASHSCREEN_PROGRESS_BAR_DIRECTION=ltr
