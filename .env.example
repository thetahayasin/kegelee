APP_NAME=Kegelee
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kegelee.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kegelee
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@kegelee.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial admin account, used by ProductionSeeder (scripts/deploy-web.ps1 -Seed)
# only when no admin exists yet. Leave ADMIN_PASSWORD blank to have a strong
# random password generated and printed once. Change it from the panel after.
ADMIN_EMAIL=admin@kegelee.com
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Server-only secret guarding the /deploy web endpoint. Generate a long random
# string; it lives on the server and nowhere else. The sync API itself uses
# per-user tokens issued at sign-in - no shared key.
DEPLOY_KEY=

# Testing only: unlock every exercise regardless of completed days (read by
# ProgressionService, which the API's pull endpoint uses).
# UNLOCK_ALL_EXERCISES=true

# TLS terminates at this app's own Apache (public/.htaccess does the
# http->https redirect), so no proxy headers are trusted. If the app is ever
# moved behind a load balancer or CDN, uncomment trustProxies in
# bootstrap/app.php as well - until then X-Forwarded-* is attacker input.

# The custom scheme the mobile app registers. Used as the fallback handoff
# when an https App Link has not been verified on the device.
APP_DEEPLINK_SCHEME=kegelee

# SHA-256 fingerprint(s) of the Android signing certificate, published at
# /.well-known/assetlinks.json so Android opens our https links in the app.
# Usually two, comma-separated: the upload key and the key Play re-signs with.
# Get them from Play Console -> Setup -> App signing.
ANDROID_APP_LINK_SHA256=

# --- Billing: RevenueCat ------------------------------------------------------
# Secret REST key (RevenueCat -> Project settings -> API keys). Without it the
# server cannot verify a purchase, and "no entitlement" becomes
# indistinguishable from "we could not ask".
REVENUECAT_API_KEY=
# The Authorization header value set on RevenueCat -> Integrations -> Webhooks.
# The webhook endpoint mints subscriptions from its request body, so it REFUSES
# every event (503) until this is set on both sides.
REVENUECAT_WEBHOOK_SECRET=
# The entitlement that unlocks the app. Only this one grants access.
REVENUECAT_ENTITLEMENT_ID=premium

# --- Billing: Google Play -----------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=com.kegelee.app
# Whole contents of the service account key file, as one line of JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Real-Time Developer Notifications authentication. In the Pub/Sub PUSH
# subscription that delivers to /webhooks/google-play, open "Enable
# authentication": pick a service account (its email goes below) and set an
# audience string (also below). Google then signs every push with an OIDC token
# carrying both, and the endpoint rejects anything else. Unset, RTDN is refused
# with a 503 rather than trusted.
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
